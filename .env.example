# Скопируй в .env и поправь под себя

# Адрес LM Studio (через Tailscale — IP машины с GPU из панели Tailscale)
LLM_BASE_URL=http://100.x.y.z:1234/v1

# Имя модели, как оно отображается в LM Studio (вкладка Local Server)
LLM_MODEL=qwen3-8b

# Порт веб-сервера ассистента
PORT=3000

# Сколько чанков базы знаний подставлять в контекст
RAG_TOP_K=4

# Температура генерации (для техподдержки лучше низкая)
LLM_TEMPERATURE=0.3
